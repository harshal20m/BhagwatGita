```
# Kotlin/Android build artifacts
*.class
*.jar
*.war
*.aar
*.apk
*.dex

# Build directories
build/
.gradle/
.externalNativeBuild/
.cxx/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/

# Local configuration
local.properties
gradle.properties

# Log files
*.log

# Temporary files
*.tmp
*.temp
*.swp

# Environment
.env
.env.local
*.env.*

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python artifacts (if any Python in project)
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# Node.js (if any JS in project)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db
```