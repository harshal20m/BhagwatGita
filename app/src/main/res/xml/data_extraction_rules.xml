<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gita_database" />
        <exclude domain="database" path="gita_database-shm" />
        <exclude domain="database" path="gita_database-wal" />
    </cloud-backup>
    <device-transfer>
        <!--
            Allow transfer of DataStore preferences (bookmarks, progress,
            reading settings) to a new device via device-to-device transfer.
        -->
        <include domain="file" path="datastore" />
        <!-- But still exclude the seeded DB — it will be re-seeded from assets -->
        <exclude domain="database" path="gita_database" />
    </device-transfer>
</data-extraction-rules>
