<?xml version="1.0" encoding="utf-8"?>
<!--
    Om symbol (ॐ) as an adaptive icon foreground / splash icon.
    Rendered at 108dp with a transparent background so the splash
    windowSplashScreenBackground color shows through.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer circle ring -->
    <path
        android:pathData="M54,10 A44,44 0 1,1 53.9,10 Z"
        android:strokeColor="#B45309"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent" />

    <!-- Om / ॐ symbol — simplified geometric representation -->
    <!-- Main body of Om -->
    <path
        android:pathData="
            M38,58
            C38,48 44,40 52,38
            C58,36 64,38 67,44
            C70,50 68,58 62,62
            C58,65 54,64 52,61
            C50,58 52,54 55,53
            C58,52 61,54 60,57
        "
        android:strokeColor="#B45309"
        android:strokeWidth="3.5"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Lower curve of Om -->
    <path
        android:pathData="M52,62 C46,66 40,72 42,78 C44,84 52,86 58,82"
        android:strokeColor="#B45309"
        android:strokeWidth="3.5"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Virama / curved tail -->
    <path
        android:pathData="M58,35 C62,30 70,30 72,35"
        android:strokeColor="#B45309"
        android:strokeWidth="3"
        android:fillColor="@android:color/transparent"
        android:strokeLineCap="round" />

    <!-- Chandrabindu dot -->
    <path
        android:pathData="M66,26 A2,2 0 1,1 65.9,26 Z"
        android:fillColor="#B45309" />

</vector>
